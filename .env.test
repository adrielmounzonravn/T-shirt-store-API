# Env for `npm run test:e2e`. DATABASE_URL is deliberately absent here — the
# Testcontainers global setup (`test/e2e/global-setup.ts`) sets it once the
# Postgres container is up. Every other value is a safe placeholder: no real
# S3/Stripe/SMTP credentials are needed to boot the app or pass the harness
# smoke test (see `docs/week-4-plan.md` Phase 0 notes).
NODE_ENV=test
PORT=3000

CART_TTL_HOURS=48
RESET_TOKEN_TTL_HOURS=1
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
LOW_STOCK_THRESHOLD=3
BCRYPT_SALT_ROUNDS=10

JWT_SECRET=e2e-test-secret
JWT_EXPIRES_IN=1h

CORS_ALLOWED_ORIGINS=http://localhost:3000

THROTTLE_TTL=60
THROTTLE_LIMIT=1000
THROTTLE_RESET_PASSWORD_TTL=60
THROTTLE_RESET_PASSWORD_LIMIT=1000

REDIS_HOST=localhost
REDIS_PORT=6379

QUEUE_JOB_ATTEMPTS=3
QUEUE_JOB_BACKOFF_DELAY_MS=2000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancel
STRIPE_CURRENCY=usd

S3_BUCKET=tshirt-store-e2e
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="T-shirt Store <no-reply@tshirtstore.dev>"
