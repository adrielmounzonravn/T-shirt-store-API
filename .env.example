# App
NODE_ENV=development
PORT=3000

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://tshirt_store:tshirt_store@localhost:5432/tshirt_store?schema=public"

# Domain settings (implementation-notes.md §3)
CART_TTL_HOURS=48
RESET_TOKEN_TTL_HOURS=1
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
LOW_STOCK_THRESHOLD=3
BCRYPT_SALT_ROUNDS=10

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=20
THROTTLE_RESET_PASSWORD_TTL=60
THROTTLE_RESET_PASSWORD_LIMIT=5

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# BullMQ job retry/backoff (stock-notification and password-change email queues)
QUEUE_JOB_ATTEMPTS=3
QUEUE_JOB_BACKOFF_DELAY_MS=2000

# Stripe (checkout + webhooks; secret key and webhook secret are optional
# outside production so the app can still boot before Phase 3/4 lands)
STRIPE_SECRET_KEY=change-me
STRIPE_WEBHOOK_SECRET=change-me
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancel
STRIPE_CURRENCY=usd

# S3 (product/variant images)
S3_BUCKET=tshirt-store-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Mailer (nodemailer transport)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="T-shirt Store <no-reply@tshirtstore.dev>"
