// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Partial unique indexes and CHECK constraints referenced below have no
// Prisma syntax and are hand-added to the migration SQL instead — see
// docs/implementation-notes.md §1 for the exact statements.

enum Role {
  manager
  client
}

enum Size {
  xs
  s
  m
  l
  xl
  xxl
}

enum Color {
  red
  blue
  white
  black
  gray
}

enum Fit {
  regular
  slim
  oversize
}

enum Gender {
  men
  women
  unisex
  kids
}

enum ProductStatus {
  enabled
  disabled
}

enum OrderStatus {
  pending
  paid
  processing
  shipped
  cancelled
}

enum CartStatus {
  active
  confirmed
  expired
}

model User {
  id         String   @id @default(uuid()) @map("user_id") @db.Uuid
  email      String   @unique
  password   String
  fullName   String   @map("full_name")
  role       Role     @default(client)
  isActive   Boolean  @default(true)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cartNumbers   CartNumber[]
  likedProducts LikedProduct[]
  usersAuth     UserAuth[]

  @@map("users")
}

model Product {
  id        String        @id @default(uuid()) @map("product_id") @db.Uuid
  name      String
  status    ProductStatus @default(disabled)
  detail    String?
  deletedAt DateTime?     @map("deleted_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  variants ProductVariant[]
  images   ProductImage[]
  likedBy  LikedProduct[]

  @@map("products")
}

// NOT NULL on size/color/fit/gender so the (product_id, size, color, fit,
// gender) uniqueness constraint actually bites — see docs/db-schema.md.
model ProductVariant {
  id        String        @id @default(uuid()) @map("sku_id") @db.Uuid
  productId String        @map("product_id") @db.Uuid
  size      Size
  color     Color
  fit       Fit
  gender    Gender
  stock     Int           @default(0)
  price     Decimal       @db.Decimal(6, 2)
  status    ProductStatus @default(enabled)
  deletedAt DateTime?     @map("deleted_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  images       VariantImage[]
  cartProducts CartProduct[]

  @@index([gender])
  @@index([size])
  @@index([fit])
  @@index([color])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid()) @map("image_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  imagePath String   @map("image_path")
  isCover   Boolean  @default(false) @map("is_cover")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model VariantImage {
  id        String   @id @default(uuid()) @map("image_id") @db.Uuid
  skuId     String   @map("sku_id") @db.Uuid
  imagePath String   @map("image_path")
  isCover   Boolean  @default(false) @map("is_cover")
  createdAt DateTime @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [skuId], references: [id])

  @@index([skuId])
  @@map("variant_images")
}

// The (cartNumber, skuId) unique makes "add to cart" an upsert.
model CartProduct {
  id         String   @id @default(uuid()) @map("cart_id") @db.Uuid
  cartNumber String   @map("cart_number") @db.Uuid
  skuId      String   @map("sku_id") @db.Uuid
  quantity   Int      @default(1)
  unitPrice  Decimal? @map("unit_price") @db.Decimal(6, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cart    CartNumber     @relation(fields: [cartNumber], references: [cartNumber])
  variant ProductVariant @relation(fields: [skuId], references: [id])

  @@unique([cartNumber, skuId])
  @@map("cart_products")
}

model CartNumber {
  cartNumber String     @id @default(uuid()) @map("cart_number") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  status     CartStatus @default(active)
  expiresAt  DateTime   @map("expires_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  cartProducts CartProduct[]
  order        Order?

  @@index([userId])
  @@map("cart_numbers")
}

// No user_id column — the order owner is reached through
// cartNumber -> CartNumber.userId. paymentMethod and totalAmount are
// computed on read, not stored (docs/db-schema.md).
model Order {
  id             String      @id @default(uuid()) @map("order_id") @db.Uuid
  cartNumber     String      @unique @map("cart_number") @db.Uuid
  idempotencyKey String      @unique @map("idempotency_key") @db.Uuid
  paymentLink    String?     @map("payment_link")
  paymentIntent  String?     @map("payment_intent")
  status         OrderStatus @default(pending)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  cart CartNumber @relation(fields: [cartNumber], references: [cartNumber])

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

// Composite PK makes liking twice a no-op.
model LikedProduct {
  userId    String @map("user_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([userId, productId])
  @@index([productId])
  @@map("liked_products")
}

// Password-reset tokens only. No created_at: it is expires_at minus the
// configured token lifetime (docs/db-schema.md).
model UserAuth {
  id        String    @id @default(uuid()) @map("user_auth_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime  @map("expires_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("users_auth")
}
