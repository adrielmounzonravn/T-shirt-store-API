{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-check.sh",
            "timeout": 300,
            "statusMessage": "Running lint, typecheck, unit and e2e tests before commit..."
          }
        ]
      }
    ]
  }
}
